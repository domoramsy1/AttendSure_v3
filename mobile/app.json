{
  "expo": {
    "name": "AttendSure",
    "slug": "attendsure-mobile",
    "version": "3.0.9",
    "orientation": "portrait",
    "icon": "./assets/attendsure-logo.svg",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.gov.deped.attendsure"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/attendsure-logo.svg",
        "backgroundColor": "#ffffff"
      },
      "package": "ph.gov.deped.attendsure",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AttendSure requires location access to verify presence inside campus boundaries for Civil Service Form 48."
        }
      ],
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-secure-store"
    ]
  }
}
